{
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "deploy": "npm run build && git add docs/ && git status --short docs/",
    "test": "vitest run",
    "test:watch": "vitest",
    "precommit:build": "npm run build && git add docs/",
    "prepare": "node -e \"require('fs').chmodSync('.git/hooks/pre-commit','755')\" 2>/dev/null || true"
  },
  "dependencies": {
    "astronomia": "^4.1.1",
    "flatpickr": "^4.6.13",
    "fuse.js": "^7.3.0",
    "lunar-javascript": "^1.7.7",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^29.0.2",
    "style-loader": "^4.0.0",
    "vitest": "^4.1.4",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "worldcities": "^0.1.8"
  }
}
